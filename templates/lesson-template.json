    "objectives": [
      {
        "id": "inquiry",
        "text": "Recognize philosophical inquiry and clarify an ambiguous question."
      },
      {
        "id": "branches",
        "text": "Distinguish major philosophical branches and their overlapping questions."
      },
      {
        "id": "arguments",
        "text": "Identify premises, conclusions, and missing assumptions."
      },
      {
        "id": "inference",
        "text": "Distinguish deductive validity, soundness, and inductive support."
      },
      {
        "id": "objections",
        "text": "Use counterexamples and charitable objections to improve a claim."
      },
      {
        "id": "application",
        "text": "Separate factual and value questions, then connect them responsibly."
      }
    ],
    "terms": [
      [
        "Claim",
        "A statement presented as true or false."
      ],
      [
        "Premise",
        "A reason offered in support of a conclusion."
      ],
      [
        "Conclusion",
        "The claim an argument asks you to accept."
      ],
      [
        "Validity",
        "A deductive argument is valid when its premises cannot all be true while its conclusion is false."
      ],
      [
        "Soundness",
        "A deductive argument is sound when it is valid and all of its premises are true."
      ],
      [
        "Counterexample",
        "A case that exposes a problem in a general claim, definition, or inference."
      ],
      [
        "Normative",
        "Concerned with what should be done, valued, or permitted."
      ],
      [
        "Empirical",
        "Investigated using observation or experience."
      ]
